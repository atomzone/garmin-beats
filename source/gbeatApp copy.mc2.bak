// =====================================================
// GARMIN ACP - CLEANED + STRICT + CORRECT FLOW
// =====================================================

using Toybox.Application as App;
using Toybox.WatchUi as Ui;
using Toybox.Media as Media;
using Toybox.Communications as Comm;
using Toybox.System as Sys;

import Toybox.Lang;

// =====================================================
// CONSTANTS
// =====================================================

module Keys {
    const SYNC_SELECTION = "SYNC_SELECTION";
    const SONGS = "SONGS";
}

// =====================================================
// APP
// =====================================================

class AppEntry extends App.AudioContentProviderApp {

    private var mProvider as StaticProvider;

    function initialize() {
        mProvider = new StaticProvider();
        App.AudioContentProviderApp.initialize();
    }

    function getContentDelegate(args) as Media.ContentDelegate {
        return new ContentDelegate();
    }

    function getSyncDelegate() as Comm.SyncDelegate? {
        return new SyncDelegate(mProvider);
    }

    function getPlaybackConfigurationView() {
        return [ new RootMenuView(mProvider) ];
    }

    function getSyncConfigurationView() {
        return getPlaybackConfigurationView();
    }
}

// =====================================================
// ROOT
// =====================================================

class RootMenuView extends Ui.View {

    private var mProvider;
    private var mShown as Boolean = false;

    function initialize(provider) {
        Ui.View.initialize();
        mProvider = provider;
    }

    function onShow() as Void {
        if (mShown) {
            Ui.popView(Ui.SLIDE_IMMEDIATE);
            return;
        }

        var menu = new Ui.Menu2({:title => "Audio"});
        menu.addItem(new Ui.MenuItem("Library", null, :library, {}));
        menu.addItem(new Ui.MenuItem("Browse", null, :browse, {}));
        menu.addItem(new Ui.MenuItem("Settings", null, :settings, {}));

        Ui.pushView(menu, new RootMenuDelegate(mProvider), Ui.SLIDE_IMMEDIATE);
        mShown = true;
    }
}

class RootMenuDelegate extends Ui.Menu2InputDelegate {

    private var mProvider;

    function initialize(provider) {
        Ui.Menu2InputDelegate.initialize();
        mProvider = provider;
    }

    function onSelect(item as Ui.MenuItem) as Void {
        var id = item.getId();

        if (id == :library) {
            Ui.pushView(new LibraryView(), null, Ui.SLIDE_IMMEDIATE);
        } else if (id == :browse) {
            Ui.pushView(mProvider.getBrowseView(), null, Ui.SLIDE_IMMEDIATE);
        } else if (id == :settings) {
            Ui.pushView(mProvider.getSettingsView(), null, Ui.SLIDE_IMMEDIATE);
        }
    }
}

// =====================================================
// LIBRARY
// =====================================================

class LibraryView extends Ui.View {

    private var mShown as Boolean = false;

    function initialize() {
        Ui.View.initialize();
    }

    function onShow() as Void {

        if (mShown) {
            Ui.popView(Ui.SLIDE_IMMEDIATE);
            return;
        }

        var iter = Media.getContentRefIter({:contentType => Media.CONTENT_TYPE_AUDIO});
        var menu = new Ui.Menu2({:title => "Library"});

        var hasContent = false;

        if (iter != null) {
            var ref = iter.next();
            while (ref != null) {
                hasContent = true;

                var obj = Media.getCachedContentObj(ref);
                var meta = obj.getMetadata();

                menu.addItem(new Ui.MenuItem(meta.title, null, ref.getId(), {}));
                ref = iter.next();
            }
        }

        if (!hasContent) {
            menu.addItem(new Ui.MenuItem("No content - Browse", null, :empty, {}));
        }

        Ui.pushView(menu, new LibraryDelegate(hasContent), Ui.SLIDE_IMMEDIATE);
        mShown = true;
    }
}

class LibraryDelegate extends Ui.Menu2InputDelegate {

    private var mHasContent as Boolean;

    function initialize(hasContent as Boolean) {
        Ui.Menu2InputDelegate.initialize();
        mHasContent = hasContent;
    }

    function onSelect(item as Ui.MenuItem) as Void {

        if (!mHasContent) {
            Ui.popView(Ui.SLIDE_IMMEDIATE);
            return;
        }

        // Only start playback if content exists
        Media.startPlayback(null);
    }
}

// =====================================================
// PLAYBACK
// =====================================================

class ContentDelegate extends Media.ContentDelegate {

    private var mIterator as ContentIterator;

    function initialize() {
        Media.ContentDelegate.initialize();
        mIterator = new ContentIterator();
    }

    function getContentIterator() as Media.ContentIterator? {
        return mIterator;
    }
}

class ContentIterator extends Media.ContentIterator {

    private var mIndex as Number = 0;
    private var mList as Array<String>;

    function initialize() {
        Media.ContentIterator.initialize();
        mList = [];

        var iter = Media.getContentRefIter({:contentType => Media.CONTENT_TYPE_AUDIO});
        if (iter != null) {
            var ref = iter.next();
            while (ref != null) {
                mList.add(ref.getId());
                ref = iter.next();
            }
        }
    }

    function get() as Media.Content? {
        if (mList.size() == 0) {
            return null;
        }

        if (mIndex >= mList.size()) {
            mIndex = 0;
        }

        return Media.getCachedContentObj(
            new Media.ContentRef(mList[mIndex], Media.CONTENT_TYPE_AUDIO)
        );
    }

    function next() as Media.Content? {
        mIndex++;
        return get();
    }

    function previous() as Media.Content? {
        if (mIndex > 0) {
            mIndex--;
        }
        return get();
    }
}

// =====================================================
// SYNC
// =====================================================

class SyncDelegate extends Comm.SyncDelegate {

    private var mProvider;
    private var mQueue as Array<Dictionary>;
    private var mTotal as Number = 0;
    private var mDone as Number = 0;

    function initialize(provider) {
        Comm.SyncDelegate.initialize();
        mProvider = provider;

        var q = App.getApp().getProperty(Keys.SYNC_SELECTION);
        mQueue = (q != null) ? q : [];
        mTotal = mQueue.size();
    }

    function isSyncNeeded() as Boolean {
        return mQueue.size() > 0;
    }

    function onStartSync() as Void {
        processNext();
    }

    function processNext() as Void {

        if (mQueue.size() == 0) {
            Media.notifySyncComplete(null);
            return;
        }

        var song = mQueue[0];
        mQueue.remove(song);

        //self.options[:mediaEncoding] = Media.ENCODING_M4A;
        // self.options[:responseType] = Communications.HTTP_RESPONSE_CONTENT_TYPE_AUDIO;

        var options = {
            :method => Comm.HTTP_REQUEST_METHOD_GET,
            :responseType => Comm.HTTP_RESPONSE_CONTENT_TYPE_AUDIO,
            :mediaEncoding => Media.ENCODING_MP3
        };

        var url = mProvider.getStreamUrl(song);

        Comm.makeWebRequest(url, song, options, method(:onDownloaded));
    }

    function onDownloaded(code as Number, data as Dictionary?) as Void {

        if (code == 200 && data != null) {

            var app = App.getApp();
            var songs = app.getProperty(Keys.SONGS);

            if (songs == null) {
                songs = {};
            }

            var refId = (data as Media.ContentRef).getId();

            // songs[refId.toString()] = {
            //     "provider" => mProvider.getName(),
            //     "remoteId" => context["id"],
            //     "title" => context["name"]
            // };

            // songs[1] = context["title"]; // simplest

            app.setProperty(Keys.SONGS, songs);

            mDone++;
            var progress = (mDone.toFloat() / mTotal.toFloat()) * 100;
            Media.notifySyncProgress(progress.toNumber());

            processNext();

        } else {
            Media.notifySyncComplete("Download failed");
        }
    }
}

// =====================================================
// PROVIDER
// =====================================================

class StaticProvider {

    function getName() as String { return "static"; }

    function getBrowseView() as Ui.View {
        return new StaticBrowseView(self);
    }

    function getSettingsView() as Ui.View {
        return new StaticSettingsView();
    }

    function fetchSongs(callback as Method) as Void {

        var songs = [
            {"id"=>"1","name"=>"Track 1","url"=>"https://getsamplefiles.com/download/m4a/sample-3.m4a"},
            {"id"=>"2","name"=>"Track 2","url"=>"https://github.com/supermihi/pytaglib/raw/refs/heads/main/tests/data/issue46.m4a"}
        ];

        callback.invoke(songs);
    }

    function getStreamUrl(song as Dictionary) as String {
        return song["url"];
    }
}

// =====================================================
// BROWSE
// =====================================================

class StaticBrowseView extends Ui.View {

    private var mProvider;
    private var mShown as Boolean = false;

    function initialize(provider) {
        Ui.View.initialize();
        mProvider = provider;
    }

    function onShow() as Void {
        if (mShown) {
            Ui.popView(Ui.SLIDE_IMMEDIATE);
            return;
        }

        mProvider.fetchSongs(method(:onSongs));
        mShown = true;
    }

    function onSongs(songs as Array<Dictionary>) as Void {

        var menu = new Ui.CheckboxMenu({:title => "Browse"});

        for (var i = 0; i < songs.size(); ++i) {
            var s = songs[i];
            menu.addItem(new Ui.CheckboxMenuItem(s["name"], null, s, false, {}));
        }

        Ui.pushView(menu, new BrowseDelegate(), Ui.SLIDE_IMMEDIATE);
    }
}

class BrowseDelegate extends Ui.Menu2InputDelegate {

    private var mSelected as Array<Dictionary>;

    function initialize() {
        Ui.Menu2InputDelegate.initialize();
        mSelected = [];
    }

    function onSelect(item) as Void {

        var song = item.getId() as Dictionary;

        if ((item as Ui.CheckboxMenuItem).isChecked()) {
            mSelected.add(song);
        } else {
            mSelected.remove(song);
        }
    }

    function onDone() as Void {
        App.getApp().setProperty(Keys.SYNC_SELECTION, mSelected);

        Sys.println("Queued " + mSelected.size() + " songs");

        Ui.popView(Ui.SLIDE_IMMEDIATE);

        // if we dont fire this manually - the sync wont happen yet....
        Communications.startSync2({
            :message => "Downloading beats"
        });
    }
}

// =====================================================
// SETTINGS
// =====================================================

class StaticSettingsView extends Ui.View {
    function initialize() {
        Ui.View.initialize();
    }

    function onUpdate(dc) {
        dc.clear();
        dc.drawText(10, 10, Graphics.FONT_SMALL, "Settings", 0);
    }
}